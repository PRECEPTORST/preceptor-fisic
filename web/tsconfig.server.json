{
  "compilerOptions": {
    "types": ["node"],
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "$lib": ["../src/lib"],
      "$lib/*": ["../src/lib/*"],
      "$env/dynamic/private": ["./server/shims/env-private.ts"],
      "$env/dynamic/public": ["./server/shims/env-public.ts"],
      "$app/environment": ["./server/shims/app-environment.ts"]
    }
  },
  "include": ["server"]
}
