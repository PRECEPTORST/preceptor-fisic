{
  "compilerOptions": {
    "types": [
      "vitest/globals",
      "vite/client",
      "node"
    ],
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "$lib": [
        "../src/lib"
      ],
      "$lib/*": [
        "../src/lib/*"
      ],
      "$env/dynamic/private": [
        "./server/shims/env-private.ts"
      ],
      "$env/dynamic/public": [
        "./server/shims/env-public.ts"
      ],
      "$app/environment": [
        "./server/shims/app-environment.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}